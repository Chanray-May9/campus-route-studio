{
  "name": "campus-route-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-03-17",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-route-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}